
# Employee database
EMPLOYEE_DB_HOST=localhost
EMPLOYEE_DB_PORT=5432
EMPLOYEE_DB_USER=postgres
EMPLOYEE_DB_PASSWORD=Root
EMPLOYEE_DB_NAME=employee_db
EMPLOYEE_SERVICE_PORT=8081

# Department database
DEPARTMENT_DB_HOST=localhost
DEPARTMENT_DB_PORT=5432
DEPARTMENT_DB_USER=postgres
DEPARTMENT_DB_PASSWORD=Root
DEPARTMENT_DB_NAME=department_db
DEPARTMENT_SERVICE_PORT=8082

# Authentication database
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=Root
AUTH_DB_NAME=auth_db
AUTH_SERVICE_PORT=8083

# Consul service discovery
CONSUL_HTTP_ADDR=http://127.0.0.1:8500

# Service URLs (legacy configuration; Consul discovery replaces these in the Gateway)
EMPLOYEE_SERVICE_URL=http://localhost:8081
DEPARTMENT_SERVICE_URL=http://localhost:8082
AUTH_SERVICE_URL=http://localhost:8083

# API Gateway
GATEWAY_PORT=8080

# JWT
JWT_SECRET=my-employee-department-management-microservices-jwt-secret-my-employee-department-management-microservices-jwt-secret-99999999999999999999999999999999999999999999

# Initial administrator account
INITIAL_ADMIN_PASSWORD=admin@123

# Asynchronous event receiver
EVENT_RECEIVER_URL=http://localhost:8084/events
