
APP_ENV=development
LOG_LEVEL=debug

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=order_management
DB_SSLMODE=disable

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

AUTH_SERVICE_PORT=8084
PRODUCT_SERVICE_PORT=8081
ORDER_SERVICE_PORT=8082
API_GATEWAY_PORT=8080

AUTH_SERVICE_NAME=auth-service
PRODUCT_SERVICE_NAME=product-service
ORDER_SERVICE_NAME=order-service
API_GATEWAY_NAME=api-gateway

CONSUL_ADDRESS=localhost:8500
CONSUL_SCHEME=http

HEALTH_CHECK_INTERVAL=10s
HEALTH_CHECK_TIMEOUT=5s
HTTP_CLIENT_TIMEOUT=10s

# Internal service-to-service authentication (use the same value for Product and Order Services)
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-internal-token

# PostgreSQL connection pool
DB_MAX_OPEN_CONNS=30
DB_MAX_IDLE_CONNS=10

# Product Service call resilience
PRODUCT_REQUEST_TIMEOUT=2s
PRODUCT_SERVICE_URL=http://localhost:8081
SERVICE_ADVERTISE_ADDRESS=127.0.0.1
CONSUL_TIMEOUT=1s
