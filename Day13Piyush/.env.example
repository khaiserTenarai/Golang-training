# Day 13 — Environment Variables Example
# Copy this to .env and modify as needed.
# In Go, load these with: export $(cat .env | xargs) && go run main.go

# Server
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
APP_ENV=development       # development, test, production

# Timeouts (seconds)
READ_TIMEOUT_SECS=10
WRITE_TIMEOUT_SECS=10
SHUTDOWN_TIMEOUT_SECS=5

# Logging
LOG_LEVEL=debug            # debug, info, warn, error
LOG_FORMAT=text            # text, json

# Feature Flags (Task 14)
FEATURE_PAGINATION=true
FEATURE_FILTERING=true
FEATURE_SORTING=true
FEATURE_AUTH=false          # set true for production

# Page limits
MAX_PAGE_SIZE=50

# Secrets (Task 8)
ADMIN_TOKEN=admin-secret-token-123
API_KEY=your-api-key-here
JWT_SECRET=your-jwt-secret
DB_PASSWORD=
