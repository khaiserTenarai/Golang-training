# ---------------------------------------------------------------
# BASE configuration (safe to commit - NO secrets in this file)
#
# Only the values you want to FORCE are set here. Everything that is
# commented out falls back to the built-in default of the chosen APP_ENV
# (development / test / production), see config/profiles.go.
#
# Priority (highest first):
#   1. real environment variables   ($env:SERVER_PORT="9000")
#   2. .env.secrets                 (secrets only, git-ignored)
#   3. .env.<APP_ENV>               (.env.test / .env.production)
#   4. this file
#   5. built-in defaults for the environment
# ---------------------------------------------------------------
APP_NAME=employee-api
APP_ENV=development

# SERVER_HOST=localhost
# SERVER_PORT=8080
# SERVER_READ_TIMEOUT=15s
# SERVER_WRITE_TIMEOUT=15s
# SERVER_IDLE_TIMEOUT=60s
# REQUEST_TIMEOUT=5s        # max time one request may spend in service/repository
# STARTUP_TIMEOUT=10s       # max time for the startup initialization
# SHUTDOWN_TIMEOUT=15s      # max time to finish in-flight requests on SIGINT/SIGTERM

# LOG_LEVEL=debug           # debug | info | warn | error
# LOG_FORMAT=text           # text | json

# PAGE_SIZE_DEFAULT=10
# PAGE_SIZE_MAX=100

# ---- feature flags ----
# FEATURE_SEARCH=true          # enables ?search= on GET /employees
# FEATURE_EXPOSE_SALARY=true   # false = salary is removed from every response
# FEATURE_SEED_DATA=true       # loads 3 sample employees at startup (not allowed in production)
